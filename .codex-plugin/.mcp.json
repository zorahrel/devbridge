{
  "mcpServers": {
    "devbridge": {
      "command": "node",
      "args": [
        "${CODEX_PLUGIN_ROOT}/server.mjs"
      ],
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "tools": {
        "run_command": {
          "approval_mode": "prompt"
        }
      },
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 600
    }
  }
}
